# Ignore Python bytecode files
*.pyc
*.pyo
*.pyd
__pycache__/

# Ignore virtual environment directories
# If you use a virtual environment, add the following:
venv/
env/
ENV/

# Ignore IDE/editor files and directories
# VSCode
.vscode/
# PyCharm
.idea/

# macOS system files
.DS_Store

# Windows system files
Thumbs.db

# Jupyter Notebook checkpoints (if applicable)
.ipynb_checkpoints/

# Ignore log files
*.log

# Ignore package distribution directories
dist/
build/
*.egg-info/

# Ignore environment configuration files (e.g., .env for secrets)
.env

# Ignore test results
nosetests.xml
coverage.xml
*.cover
*.py,cover
*.tox
*.nox
*.coverage
*.hypothesis

# Ignore coverage and cache files
.coverage
.cache/
.pytest_cache/

